---
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/components/Cta.astro";
import type { TPostType, TPlan } from "@/types";
import { getEntryBySlug } from "astro:content";

const entry = (await getEntryBySlug("pricing", "index")) as TPostType;
const { title, description, plans, call_to_action } = entry.data;
---

<Base title={title} description={description}>
  <section class="section pb-0">
    <div class="container">
      <h1 class="text-center font-normal">{title}</h1>
      <p class="mx-auto mt-6 w-fit rounded-full bg-primary px-6 py-2 text-center text-lg font-bold text-white">
        🎁 Todos los planes son gratis durante el primer mes
      </p>
      <p class="mt-4 text-center">Probalo 30 días sin pagar y sin cargar una tarjeta. Después, precios mensuales en guaraníes. Sin cupos de citas, clientes ni ventas.</p>
      <div class="section row -mt-10 justify-center md:mt-0">
        {
          plans?.map((plan: TPlan) => (
            <div
              class={`col-12 md:col-4 ${
                !plan.recommended ? "lg:px-0" : "col-recommended"
              }`}
            >
              <div class="card text-center">
                <span class="mb-3 inline-block rounded-full bg-primary/10 px-4 py-1 text-sm font-bold text-primary">
                  1.er mes gratis
                </span>
                <h4>{plan.title}</h4>
                <div class="mt-5">
                  <span class="text-2xl text-dark">Gs.</span>{" "}
                  <span class="text-5xl text-dark">
                    {new Intl.NumberFormat("es-PY").format(plan.price)}
                  </span>
                  <span>/ {plan.type}</span>
                </div>
                <p class="mt-2 text-sm font-semibold text-primary">Gs. 0 el primer mes · sin tarjeta</p>
                <h5 class="mt-2 font-normal text-text">{plan.subtitle}</h5>
                <ul class="mt-5">
                  {plan?.features?.map((feature, index) => (
                    <li class="mb-[10px] leading-5">{feature}</li>
                  ))}
                </ul>
                <a
                  class={`btn mt-5 ${
                    plan.recommended ? "btn-primary" : "btn-outline-primary"
                  }`}
                  href={plan.button.link}
                >
                  {plan.button.label}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <Cta cta={call_to_action} />
</Base>
